# ── Shared ──────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://arya:arya@localhost:5432/arya
# Local fallback without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./arya.db

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Provider keys (server-side only) ────────────────
HEYGEN_API_KEY=
ANAM_API_KEY=
TAVUS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Avatar provider: mock | heygen | anam | tavus
DEFAULT_AVATAR_PROVIDER=mock

# ── LiveKit (optional) ──────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Ringg AI phone-call channel (optional) ──────────
RINGG_API_KEY=
RINGG_BASE_URL=https://prod-api.ringg.ai/ca/api/v0
RINGG_AGENT_ID=
RINGG_FROM_NUMBER_ID=
RINGG_WEBHOOK_TOKEN=

# ── Bolti AI phone-call channel (optional) ──────────
BOLTI_TOKEN=
BOLTI_BASE_URL=https://api.bolti.co.in/v1
BOLTI_AGENT_ID=
BOLTI_FROM_NUMBER=
BOLTI_WEBHOOK_SECRET=

# ── Encryption for stored provider keys ─────────────
FERNET_KEY=

# ── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Feature defaults ────────────────────────────────
CAPTIONS_DEFAULT=true
BARGE_IN_ENABLED=true
MAINTENANCE_MODE=false
MIN_ANDROID_VERSION=1
MIN_WEB_VERSION=1
